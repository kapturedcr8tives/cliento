# Staging Environment Configuration
NODE_ENV=staging
LOG_LEVEL=debug

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-staging-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-supabase-anon-key

# Database Configuration
DATABASE_URL=your-staging-database-url

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Security Configuration
JWT_SECRET=your-staging-jwt-secret
ENCRYPTION_KEY=your-staging-encryption-key

# External Services
SMTP_HOST=smtp.staging.example.com
SMTP_PORT=587
SMTP_USER=your-staging-smtp-user
SMTP_PASS=your-staging-smtp-password

# Feature Flags
FEATURE_FLAG_ANALYTICS=true
FEATURE_FLAG_BETA_FEATURES=true